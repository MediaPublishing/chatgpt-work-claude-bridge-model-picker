From 66c4c6ce45deb2380320e376c33c2aa9551e191f Mon Sep 17 00:00:00 2001
From: AInauten <noreply@ainauten.com>
Date: Thu, 27 Aug 2026 19:26:56 -0400
Subject: [PATCH 2/3] Schema-Grenzen fuer weiterverkaufte Kimi-Modelle
 verdrahten

Der lokale Ad-hoc-Sanitizer entfaellt. v0.5.0 bringt tool-schema-root.mjs;
providerToolSchema repariert oneOf/anyOf/allOf-Wurzeln bereits generisch fuer
alle Chat-Completions-Provider, und repairToolSchemaRoots({inlineForeignRefs:
true}) loest die $ref-Geschwister sauberer auf als unser Strip.

Nur die Verdrahtung fehlte: needsMoonshotSchemaCompatibility matcht bisher nur
Moonshots eigene Provider, nicht das ueber opencode-go-messages weiterverkaufte
kimi-k3, das denselben strengen Validator trifft und dieselbe
Ganzanfrage-Fehlermeldung ausloest.
---
 src/router.mjs | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/router.mjs b/src/router.mjs
index 60c5402..28c63d7 100644
--- a/src/router.mjs
+++ b/src/router.mjs
@@ -760,8 +760,19 @@ function needsStrictOpenCodeToolCompatibility(route) {
 // schema flavor. Keep the rewrite off every non-Moonshot provider.
 const MOONSHOT_PROVIDER_IDS = new Set(["kimi-oauth", "kimi-api", "kimi-api-cn"]);
 
+// Local (2026-08-27): the validator travels with the model, not with the
+// vendor's own endpoints. A Moonshot model resold through another gateway --
+// `opencode-go-messages/kimi-k3` here -- reaches the same first-party
+// validator and rejects the same sibling-carrying `$ref` with the same
+// whole-request error. Match the upstream model id rather than widening the
+// provider set: `opencode-go-messages` also serves non-Moonshot models that
+// must keep their untouched schemas.
+function isMoonshotUpstreamModel(route) {
+  return /(^|[^a-z])kimi([^a-z]|$)/i.test(String(route?.upstreamModel || ""));
+}
+
 function needsMoonshotSchemaCompatibility(route) {
-  return MOONSHOT_PROVIDER_IDS.has(providerForModel(route)?.id);
+  return MOONSHOT_PROVIDER_IDS.has(providerForModel(route)?.id) || isMoonshotUpstreamModel(route);
 }
 
 function zenFreeCompatibleInput(input, route) {
