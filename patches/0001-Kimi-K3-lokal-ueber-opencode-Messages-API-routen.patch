From 586a65a9bb7cf7a6b25c945d47af80a570d05599 Mon Sep 17 00:00:00 2001
From: AInauten <noreply@ainauten.com>
Date: Thu, 27 Aug 2026 12:00:07 -0400
Subject: [PATCH 1/3] Kimi K3 lokal ueber opencode Messages-API routen

Der Anbieter hat das Format am 2026-08-24 gewechselt; die Chat-Completions-
Route liefert fuer kimi-k3 keine brauchbaren Antworten mehr. Modell auf den
Provider opencode-go-messages umhaengen, aus der Liste nehmen (listed:false)
und den Upgrade-Hinweis auf K2.6 entfernen, der sonst auf den toten Slug
opencode-go/kimi-k3 zeigt. compHash folgt der Konvention gatewayModel-vN.
---
 config/opencode/go/kimi-k2.6.json |  4 ----
 config/opencode/go/kimi-k3.json   | 12 ++++++------
 2 files changed, 6 insertions(+), 10 deletions(-)

diff --git a/config/opencode/go/kimi-k2.6.json b/config/opencode/go/kimi-k2.6.json
index b8da85d..fbad177 100644
--- a/config/opencode/go/kimi-k2.6.json
+++ b/config/opencode/go/kimi-k2.6.json
@@ -10,10 +10,6 @@
       "displayName": "Kimi K2.6 (opencode Go)",
       "description": "Kimi K2.6 through the opencode Go subscription.",
       "priority": 35,
-      "upgradeTo": {
-        "model": "opencode-go/kimi-k3",
-        "markdown": "Kimi K3 is available on your opencode Go subscription\n\n{model_to} is Moonshot's successor to {model_from}, running at maximum reasoning effort with the same 256K-token context window. Accept to switch your default model; Kimi K2.6 stays available in the picker."
-      },
       "defaultEffort": "high",
       "reasoningLevels": [
         {
diff --git a/config/opencode/go/kimi-k3.json b/config/opencode/go/kimi-k3.json
index 9f2a079..350c489 100644
--- a/config/opencode/go/kimi-k3.json
+++ b/config/opencode/go/kimi-k3.json
@@ -2,13 +2,13 @@
   "version": 1,
   "models": [
     {
-      "slug": "opencode-go/kimi-k3",
-      "gatewayModel": "opencode-go-kimi-k3",
+      "slug": "opencode-go-messages/kimi-k3",
+      "gatewayModel": "opencode-go-messages-kimi-k3",
       "upstreamModel": "kimi-k3",
-      "provider": "opencode-go",
-      "listed": true,
+      "provider": "opencode-go-messages",
+      "listed": false,
       "displayName": "Kimi K3 (opencode Go)",
-      "description": "Kimi K3 through the opencode Go subscription.",
+      "description": "Kimi K3 through the opencode Go subscription using the Messages API (Formatwechsel beim Anbieter 2026-08-24).",
       "priority": 33,
       "defaultEffort": "max",
       "reasoningLevels": [
@@ -32,7 +32,7 @@
         "image"
       ],
       "requestProfile": "kimi-k3",
-      "compHash": "opencode-go-kimi-k3-v2"
+      "compHash": "opencode-go-messages-kimi-k3-v2"
     }
   ]
 }
-- 
2.55.0

